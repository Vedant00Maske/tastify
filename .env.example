# Copy to .env and adjust. .env is git-ignored: never commit real credentials.
# Read by docker compose (variable substitution) and by the backend settings (app/core/config.py).

# --- Application -----------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON array of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]
# Unauthenticated /api/v1/users/{id}/... endpoints (Milestone 3, until authentication in M4).
# Unset: served only when ENVIRONMENT is local or test. Never set to true on a reachable server.
# DEV_USER_API=false

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=tastify
POSTGRES_PASSWORD=tastify
POSTGRES_DB=tastify
# For running the backend on the host. docker compose overrides the host to "postgres".
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 ::1 first, adding ~2 s per connection.
DATABASE_URL=postgresql+asyncpg://tastify:tastify@127.0.0.1:5432/tastify

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- Music providers (Milestone 5: not read by the application yet) -----------
# Spotify Web API: https://developer.spotify.com/dashboard
# Redirect URIs must use the loopback IP literal (127.0.0.1), not "localhost".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/spotify/callback

# YouTube Data API v3 (Google Cloud console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/youtube/callback
YOUTUBE_API_KEY=

# --- MetaBrainz (MusicBrainz, ListenBrainz, data dumps) ------------------------
# Every request must identify the application and a contact (URL or e-mail).
METABRAINZ_USER_AGENT="TASTIFY/0.1.0 ( https://github.com/Vedant00Maske/tastify )"
# ListenBrainz uses per-user tokens supplied when a user connects; there is no app-wide secret.

# --- ML data pipelines (ml/) -------------------------------------------------
# Secret used to pseudonymise ListenBrainz user names (HMAC). Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# and keep it stable: changing it changes every user key in the processed datasets.
LISTENS_PSEUDONYM_KEY=
# Number of most recent daily listen dumps, catalogue size, and minimum distinct listeners.
LISTENS_DAYS=14
CATALOGUE_SIZE=30000
CATALOGUE_MIN_LISTENERS=3
