# Settings for the smoke-test stack (docker-compose.smoke.yml). Test values only: this stack
# runs on plain HTTP on 127.0.0.1 and is torn down after the test.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
APP_PUBLIC_URL=http://127.0.0.1:8080
CORS_ORIGINS=["http://127.0.0.1:8080"]
ENVIRONMENT=staging
API_REPLICAS=2
RECOMMENDER_REPLICAS=2
WORKER_CONCURRENCY=2
POSTGRES_PASSWORD=smoke-test-database-password
REDIS_PASSWORD=smoke-test-redis-password
MAIL_FROM=SONIQUEO smoke test <no-reply@soniqueo.test>
GRAFANA_ADMIN_PASSWORD=smoke-test-grafana-password
BACKUP_INTERVAL_SECONDS=86400
LOG_LEVEL=INFO
# The load test sends a different X-Forwarded-For per virtual user from the host (Docker's
# private gateway): trust it, as a deployment behind a load balancer would.
CADDY_TRUSTED_PROXIES=private_ranges
