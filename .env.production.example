# TASTIFY production settings for docker-compose.prod.yml (DEPLOYMENT.md, RUNBOOK.md).
# Copy to .env.production on the server (git-ignored), fill in every "change-me", and keep it
# readable only by the deploying user (chmod 600). The API refuses to start in production while
# a setting is unsafe (python -m app.cli check-config lists them).
#
# Generate secrets with: openssl rand -base64 32   (or python -c "import secrets;print(secrets.token_urlsafe(32))")

# --- Site ------------------------------------------------------------------------------------
# Public domain: Caddy gets an HTTPS certificate for it automatically (DNS must point here).
SITE_ADDRESS=tastify.example.com
APP_PUBLIC_URL=https://tastify.example.com
CORS_ORIGINS=["https://tastify.example.com"]
ENVIRONMENT=production

# --- Images ------------------------------------------------------------------------------------
# scripts/deploy.sh pulls the release images from here (GitHub Container Registry by default).
IMAGE_PREFIX=ghcr.io/<owner>
# Without deploy.sh, images are built locally unless these name published images:
# BACKEND_IMAGE=ghcr.io/<owner>/tastify-backend:v0.7.0
# FRONTEND_IMAGE=ghcr.io/<owner>/tastify-frontend:v0.7.0

# --- Capacity ----------------------------------------------------------------------------------
# One process per replica. A starting point for a 4-core host: 2 api + 2 recommender.
API_REPLICAS=2
RECOMMENDER_REPLICAS=2
WORKER_CONCURRENCY=4
# Connections per replica (pool + overflow); keep replicas x (pool + overflow) + worker below
# POSTGRES_MAX_CONNECTIONS.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
REDIS_MAXMEMORY=512mb

# --- Data stores -------------------------------------------------------------------------------
POSTGRES_USER=tastify
POSTGRES_DB=tastify
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# --- Secrets ---------------------------------------------------------------------------------
# Encrypts connected-service tokens (32 random bytes, base64). Back it up separately from the
# database backups: without it, stored tokens are unusable. Rotation: RUNBOOK.md.
INTEGRATIONS_TOKEN_KEY=change-me
# INTEGRATIONS_TOKEN_PREVIOUS_KEYS=["<old key>"]

# --- E-mail (password reset, address verification) --------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
MAIL_FROM=TASTIFY <no-reply@tastify.example.com>

# --- Music services (optional; INTEGRATIONS.md) ------------------------------------------------
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# METABRAINZ_USER_AGENT=TASTIFY/0.1.0 ( https://tastify.example.com/contact )

# --- Observability -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# Error tracking (Sentry or compatible). Unset: errors are only logged.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# Monitoring stack (--profile monitoring): Grafana on 127.0.0.1:3001 via SSH tunnel.
GRAFANA_ADMIN_PASSWORD=change-me
PROMETHEUS_RETENTION=30d

# --- Retention and backups ---------------------------------------------------------------------
RECOMMENDATION_LOG_RETENTION_DAYS=90
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
